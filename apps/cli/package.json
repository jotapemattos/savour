{
  "name": "@savour/cli",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "savour": "./bin/savour"
  },
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "cli": "pnpm run --silent build && node dist/cli.js",
    "check": "pnpm run typecheck",
    "pretest": "pnpm run --silent build",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0",
    "@savour/capability": "workspace:*",
    "@savour/core": "workspace:*",
    "@savour/devtools": "workspace:*",
    "effect": "4.0.0"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0",
    "@types/node": "24.13.6",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
