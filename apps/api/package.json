{
  "name": "@savour/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./worker": {
      "types": "./src/worker.ts",
      "import": "./src/worker.ts",
      "default": "./src/worker.ts"
    },
    "./database-resources": {
      "types": "./src/database-resources.ts",
      "import": "./src/database-resources.ts",
      "default": "./src/database-resources.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm run typecheck"
  },
  "dependencies": {
    "@effect/sql-pg": "4.0.0",
    "@savour/capability": "workspace:*",
    "@savour/core": "workspace:*",
    "alchemy": "2.0.0-beta.83",
    "effect": "4.0.0",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.0",
    "@effect/vitest": "4.0.0",
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
