{
  "name": "@savour/core",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./flags": {
      "types": "./src/flags.ts",
      "import": "./dist/flags.js",
      "default": "./dist/flags.js"
    },
    "./flag-control": {
      "types": "./src/flag-control.ts",
      "import": "./dist/flag-control.js",
      "default": "./dist/flag-control.js"
    },
    "./flag-write-capabilities": {
      "types": "./src/flag-write-capabilities.ts",
      "import": "./dist/flag-write-capabilities.js",
      "default": "./dist/flag-write-capabilities.js"
    },
    "./flag-capabilities": {
      "types": "./src/flag-capabilities.ts",
      "import": "./dist/flag-capabilities.js",
      "default": "./dist/flag-capabilities.js"
    },
    "./request-geo": {
      "types": "./src/request-geo.ts",
      "import": "./dist/request-geo.js",
      "default": "./dist/request-geo.js"
    },
    "./health": {
      "types": "./src/health-capabilities.ts",
      "import": "./dist/health-capabilities.js",
      "default": "./dist/health-capabilities.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm run typecheck",
    "pretest": "pnpm run --silent build"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0",
    "@savour/capability": "workspace:*",
    "@xstate/effect": "0.1.0-alpha.7",
    "effect": "4.0.0",
    "xstate": "6.0.0-alpha.65"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0",
    "@types/node": "24.13.6",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
